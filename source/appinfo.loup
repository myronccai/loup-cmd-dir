@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "dir";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "List directory contents in the Windows format (a Loup recreation of the Windows dir command).";

# Exit statuses returned by main(). Like cmd.exe's dir, a usage error is
# ERRORLEVEL 1, the same as "File Not Found".
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
