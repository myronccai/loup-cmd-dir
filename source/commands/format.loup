@mode(host.dual)

# The text of a dir listing: entry lines in the long and wide formats, the
# "Directory of" header and the File(s) / Dir(s) summary lines, laid out in
# Windows' columns. Pure functions.
#
# Runtime: host.dual. Compiled into the native binary build/dir by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/format_test.loup calls it under Stage0.

from commands.entries import (Entry);
from core.string_utils import (padLeft, padRight);

# Where the date and time would be: "MM/DD/YYYY  HH:MM AM" is 20 columns.
# Loup 1.26.0 has no stat(), so the columns are left blank.
pub const DATE_TIME_BLANK: string = "                    ";

# The default screen width for /W and /D.
pub const DEFAULT_WIDTH: int = 80;

# A count or size as dir prints it: `1,234,567` with separators (/C, the
# default), `1234567` without (/-C).
pub func group_digits(n: int, separators: bool): string {
    let digits = str(n);
    if (!separators or digits.len() <= 3) {
        return digits;
    }
    # The first group holds what is left over (1 or 2 digits), then groups
    # of three follow.
    var parts: list[string] = [];
    let first = digits.len() % 3;
    if (first > 0) {
        parts.push(digits.slice(0, first));
    }
    for (var i = first; i < digits.len(); i = i + 3) {
        parts.push(digits.slice(i, i + 3));
    }
    return parts.join(",");
}

# The name as shown: lower case with /L.
pub func shown_name(name: string, lower: bool): string {
    return if (lower) { name.toLowerCase() } else { name };
}

# One entry in the long format: date and time (blank), then `<DIR>` or the
# size right-aligned so that it ends in column 38, then the name.
pub func long_line(e: Entry, separators: bool, lower: bool): string {
    var field = "";
    if (e.is_dir) {
        field = padRight("<DIR>", 14, " ");
    } else {
        field = padLeft(group_digits(e.size, separators), 14, " ");
    }
    return DATE_TIME_BLANK + "    " + field + " " + shown_name(e.name, lower);
}

# The name of an entry in the wide format: directories in brackets.
pub func wide_name(e: Entry, lower: bool): string {
    let name = shown_name(e.name, lower);
    if (e.is_dir) {
        return "[" + name + "]";
    }
    return name;
}

# The wide format (/W, or /D sorted down the columns): as many columns of
# (longest name + 1) characters as fit in `width`, keeping a space between
# columns. Every name is padded, also the last one on a line.
pub func wide_lines(entries: list[Entry], width: int, by_column: bool, lower: bool): list[string] {
    var lines: list[string] = [];
    let count = entries.len();
    if (count == 0) {
        return lines;
    }
    var names: list[string] = [];
    var longest = 1;
    for (e in entries) {
        let name = wide_name(e, lower);
        names.push(name);
        if (name.len() > longest) {
            longest = name.len();
        }
    }
    var columns = width / longest;
    if (longest * columns + columns >= width) {
        columns -= 1;
    }
    if (columns < 1) {
        columns = 1;
    }
    let rows = (count + columns - 1) / columns;
    for (row in 0..rows) {
        var parts: list[string] = [];
        for (col in 0..columns) {
            let index = if (by_column) { col * rows + row } else { row * columns + col };
            if (index >= count) {
                break;
            }
            parts.push(padRight(names[index], longest + 1, " "));
        }
        lines.push(parts.join(""));
    }
    return lines;
}

# The header of one directory's block: a blank line, ` Directory of X` and
# a blank line. `display` is already in Windows form (`\tmp\x`).
pub func header_lines(display: string): list[string] {
    return ["", " Directory of " + display, ""];
}

# `               2 File(s)          1,234 bytes`
pub func files_line(count: int, total: int, separators: bool): string {
    return padLeft(group_digits(count, separators), 16, " ") + " File(s) "
        + padLeft(group_digits(total, separators), 14, " ") + " bytes";
}

# `               3 Dir(s)`: Windows adds the free space of the volume,
# which Loup 1.26.0 cannot query.
pub func dirs_line(count: int, separators: bool): string {
    return padLeft(group_digits(count, separators), 16, " ") + " Dir(s)";
}

# The lines that introduce the grand total after several blocks (or /S).
pub func total_header_lines(): list[string] {
    return ["", "     Total Files Listed:"];
}
